---
import MainLayout from "../../layouts/MainLayout.astro";import AudioButton from "../../components/AudioButton";import WordActions from "../../components/WordActions";import words from "../../data/vocabulary.json";import cats from "../../data/categories.json";
export function getStaticPaths(){return words.map(w=>({params:{slug:w.slug},props:{word:w}}));}
const {word}=Astro.props;const cat=cats.find(c=>c.slug===word.category);const i=words.findIndex(w=>w.id===word.id);const prev=words[(i-1+words.length)%words.length];const next=words[(i+1)%words.length];
---
<MainLayout title={`${word.translation} dalam Bahasa Arab | Arabiyya`}><main class="container py-12"><a href={`/categories/${word.category}/`} class="text-sm font-bold text-[#164e42]">← Kembali ke {cat.name}</a><div class="card mx-auto mt-7 max-w-3xl overflow-hidden"><div class="grid md:grid-cols-2"><div class="bg-[#f0f4ed] p-6"><img src={word.image} alt={`Ilustrasi ${word.translation}`} class="h-full max-h-80 w-full rounded-2xl object-cover"/></div><div class="p-7 sm:p-9"><span class="rounded-full bg-[#f2f5ef] px-3 py-1 text-xs font-bold text-[#557064]">{cat.name}</span><div class="arabic-large mt-5">{word.arabic}</div><h1 class="text-xl font-extrabold text-[#164e42]">{word.translation}</h1><p class="mt-1 text-sm muted">{word.transliteration}</p><div class="mt-5"><AudioButton client:load text={word.arabic}/></div><div class="mt-7 rounded-2xl bg-[#f8f8f4] p-4"><p class="text-xs font-extrabold uppercase tracking-widest text-[#b18432]">Contoh kalimat</p><div class="arabic mt-2 text-2xl">{word.example.arabic}</div><p class="mt-1 text-sm muted">{word.example.translation}</p></div><div class="mt-6"><WordActions client:load id={word.id}/></div></div></div><div class="flex items-center justify-between p-5"><a class="btn-secondary text-sm" href={`/vocabulary/${prev.slug}/`}>← Sebelumnya</a><a class="btn-primary text-sm" href={`/vocabulary/${next.slug}/`}>Selanjutnya →</a></div></div></main></MainLayout>