---
import MainLayout from "../../layouts/MainLayout.astro";import cats from "../../data/categories.json";import words from "../../data/vocabulary.json";
---
<MainLayout title="Kategori | Arabiyya"><main class="container py-12"><div class="eyebrow">MATERI PEMBELAJARAN</div><h1 class="mt-2 text-3xl font-extrabold">Kategori kosakata</h1><p class="mt-3 muted">Pilih tema untuk mulai belajar.</p><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{cats.map(c=><a href={`/categories/${c.slug}/`} class="card p-6"><div class="category-icon">{c.icon}</div><div class="arabic mt-4 text-2xl">{c.arabic}</div><h2 class="mt-2 font-bold">{c.name}</h2><p class="mt-2 text-sm muted">{c.description}</p><p class="mt-4 text-xs font-bold text-[#164e42]">{words.filter(w=>w.category===c.slug).length} kosakata →</p></a>)}</div></main></MainLayout>